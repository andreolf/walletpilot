{
  "name": "@walletpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm",
    "vercel-build": "echo \"No build step on Vercel: it compiles api/index.ts itself; src/ is the standalone Node server and is excluded by .vercelignore\"",
    "start": "node dist/index.js",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.119.2",
    "hono": "^4.13.23",
    "viem": "^2.58.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "24.x"
  }
}
